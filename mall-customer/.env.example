# LLM Provider
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# Redis (Agent State 检查点存储，需 Redis Stack / Redis 8+)
# 注意：端口需与本地实际 Redis Stack 实例一致（mall-server 使用 6381）
REDIS_URL=redis://:123456@localhost:6381/0

# mall-server（Java）内部接口：Agent 查询真实订单等业务数据
MALL_SERVER_URL=http://localhost:8800
MALL_SERVER_INTERNAL_TOKEN=change-me

# 工单持久化：SQLite 文件路径（跨重启保留工单）
TICKET_DB_PATH=./data/tickets.db

# 商品知识库定时增量同步间隔（秒），<=0 时关闭；亦可调用 POST /api/kb/sync 手动触发
KB_SYNC_INTERVAL_SECONDS=3600

# Vector Store (长期记忆)
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./vector_store/faiss_index
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# OpenTelemetry (全链路追踪)
OTEL_SERVICE_NAME=mall-customer
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# LangSmith (可选)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Server
HOST=0.0.0.0
PORT=8000